# copy to .env (git ignored) and fill in. Only used by the Playwright tests in tests/e2e.

# start page of the tenant, the browser opens it for the login
CPI_URL=https://<subaccount>.integrationsuite.cfapps.<region>.hana.ondemand.com/shell/home
# an iFlow in design mode that has processed messages, read only tests open it
CPI_IFLOW_URL=https://<subaccount>.integrationsuite.cfapps.<region>.hana.ondemand.com/shell/design/contentpackage/<package>/integrationflows/<iflow>
# optional: an API artifact (API / MCP server page)
CPI_API_URL=
# optional: an iFlow for paste tests in edit mode (the tests cancel the edit, nothing is saved)
CPI_SNIPPETS_IFLOW_URL=
# optional: monitor page
CPI_MONITOR_URL=

# local browser for the tests: profile folder and DevTools port the tests connect to
E2E_PROFILE_DIR=.e2e-profile
E2E_CDP_PORT=9333

# trace.spec.mjs switches trace on, deploys CPI_IFLOW_URL and debugs the new message. only for a test iFlow
E2E_ALLOW_DEPLOY=false

# snippets.spec.mjs switches CPI_SNIPPETS_IFLOW_URL to edit mode, pastes a snippet and discards the edit (never saves)
E2E_ALLOW_EDIT=false
